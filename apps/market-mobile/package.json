    "expo-notifications": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
