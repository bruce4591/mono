[Unit]
Description=Market Binance 1m kline WebSocket collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/github/mono
EnvironmentFile=-/home/ubuntu/github/mono/.market.env
Environment=MARKET_APP_DIR=/home/ubuntu/github/mono
Environment=MARKET_WS_TOP_USDT_LIMIT=60
ExecStart=/home/ubuntu/github/mono/deploy/scripts/market-run-binance-kline-ws.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
