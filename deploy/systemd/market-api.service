[Unit]
Description=Market MVP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/github/mono
EnvironmentFile=-/home/ubuntu/github/mono/.market.env
ExecStart=/home/ubuntu/github/mono/.venv/bin/market serve-api --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
